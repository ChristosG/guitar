# ---- Postgres ----
POSTGRES_USER=guitar
POSTGRES_PASSWORD=guitar
POSTGRES_DB=guitar
DATABASE_URL=postgresql+psycopg://guitar:guitar@postgres:5432/guitar

# ---- LLM provider (dev default: local Qwen via vLLM) ----
#
# SWITCHING TO CLAUDE: set LLM_PROVIDER=claude and *** BLANK LLM_BASE_URL ***.
# `ClaudeProvider` forwards a non-empty LLM_BASE_URL to the Anthropic SDK as its
# `base_url`, so leaving the Qwen URL below in place points every Claude call at
# the local vLLM container. It does not fail loudly — it fails as a CONNECTION
# error, which the Settings screen honestly reports as "couldn't reach Anthropic,
# check your internet", sending the tutor off to debug his wifi over a config typo.
# The API key itself does NOT go here in the Claude era: the tutor pastes it into
# the Settings screen and it is stored encrypted in `app_setting` (LLM_API_KEY is
# only a CI/bootstrap fallback).
#
# THREE PROVIDERS, THREE WALLETS:
#
#   qwen        local vLLM 9B. Free. Weak at Greek — the reason the others exist.
#   claude      the Anthropic API. Excellent. Needs a PAID API KEY, pasted into
#               the Settings screen. A Claude Max subscription does NOT provide
#               one: it buys zero API credits. Separate product, separate bill.
#   claude_cli  Claude on your Max SUBSCRIPTION, via the `claude` CLI. No key,
#               no per-token cost. Bounded by the subscription's 5-hour/weekly
#               rate limits instead. A proof of concept — see below.
#
# claude_cli needs NOTHING extra to run. `docker compose up -d --build` brings up the
# `claude-bridge` service alongside the api, and that service owns the CLI. Set a
# CLAUDE_BRIDGE_TOKEN below and you are done.
#
# `claude` never runs in the API container, and ~/.claude is never mounted into it.
# It runs in the sibling `claude-bridge` container, which is the ONLY one that sees
# the credential — because ~/.claude/.credentials.json also holds live OAuth tokens
# for every MCP server you have ever authorised (Linear, GitLab, HuggingFace, ...),
# and the API container is the web-facing one. Full reasoning in
# tools/claude_bridge/README.md.
LLM_PROVIDER=qwen
LLM_API_KEY=none
LLM_BASE_URL=http://qwen-vllm:6888/v1
LLM_MODEL=/models/Qwen3.5-9B

# WHICH provider reads page scans. Unset (the default) = the same one as
# LLM_PROVIDER — every install gets this and nothing changes until you touch
# it. Set this when chat should run on the subscription (LLM_PROVIDER=
# claude_cli, free per token) but OCR should run on a real API key (pennies
# for the whole library, ~40 minutes, and it does not spend the subscription's
# 5-hour rolling cap the way `claude -p` does):
#   OCR_PROVIDER=claude
# The model comes from the same resolution chat uses (the Settings screen's
# picker, or DEFAULT_MODEL) — there is no separate OCR_MODEL knob.
OCR_PROVIDER=

# Pages routed to vision are re-rendered from the source PDF at this DPI
# before being sent to the model. 110 is a Qwen vLLM ceiling, not a quality
# choice — the local vLLM rejects a 150dpi image outright. Claude is a
# high-resolution tier and wants the extra detail: small glyphs like ¼ vs ⅛
# differ by only a few pixels at page scale. Only pages actually routed to
# vision pay this (a small fraction of any book); the stored scan stays at
# 110dpi regardless.
OCR_RENDER_DPI=150

# claude_cli ONLY. Ignored by the other two providers.
# Plain compose DNS — the `claude-bridge` service on the internal appnet. It
# publishes no host port, so nothing outside Docker can reach it.
CLAUDE_BRIDGE_URL=http://claude-bridge:8799
# Shared secret between api and claude-bridge. The bridge REFUSES TO START without
# one: it serves an endpoint that spends your subscription, and an unauthenticated
# one is not a thing to ship even on an internal network. Generate with:
#     openssl rand -hex 32
CLAUDE_BRIDGE_TOKEN=
EMBED_BASE_URL=http://qwen-emb-vllm:8090/v1
EMBED_MODEL=qwen3-emb-4b
EMBED_DIM=2560

# ---- App ----
API_PORT=8791
WEB_PORT=8790
# NEXT_PUBLIC_API_BASE — leave UNSET. `lib/api.ts` derives it in the browser from
# window.location, so ONE web image serves both localhost and the deployed site.
# Setting it here bakes a constant into the client bundle and breaks whichever
# environment it does not describe. Only set it if your API is not at
# guitar-api.<your-domain>.
#NEXT_PUBLIC_API_BASE=

# ---- Auth (Plan 13 Task 3) ----
# OFF by default. Every pytest run and every `next dev` session assumes off;
# the deployed app turns it on. When on and APP_PASSWORD is empty, EVERY login
# fails (fail closed) — an operator who forgets the password gets a locked door,
# not an open one.
AUTH_ENABLED=0
APP_PASSWORD=
# Signs the `gt_session` cookie. Rotating it logs the tutor out.
APP_SECRET=dev-insecure-session-secret-change-me
# Encrypts the stored Anthropic key at rest. A SEPARATE secret on purpose:
# rotating APP_SECRET must not brick the key the tutor pasted.
ENCRYPTION_SECRET=dev-insecure-encryption-secret-change-me
# Empty on localhost => a HOST-ONLY cookie. Cookies ignore the PORT, so a
# host-only cookie set by the API on :8791 is sent to the web app on :8790.
# In production: COOKIE_DOMAIN=.cgrigoriadis.online (one cookie, both subdomains)
# and COOKIE_SECURE=1 (a Secure cookie is silently DROPPED over plain http, so
# turning it on in dev looks like a login that does nothing).
COOKIE_DOMAIN=
COOKIE_SECURE=0
# The web app's own copy: `proxy.ts` only bounces to /login when this is "1".
# The API is the real gate — this is UX, and getting it wrong in dev would send
# a developer to a login screen with no password to type.
NEXT_PUBLIC_AUTH_ENABLED=0
